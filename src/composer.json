{
    "name": "sgfp/sgfp",
    "description": "Sistema de Gestão Financeira Pessoal — plugin WordPress",
    "type": "wordpress-plugin",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-sodium": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^1.10",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "SGFP\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SGFP\\Tests\\": "src/Tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.1"
        },
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
